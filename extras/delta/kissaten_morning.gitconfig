# Kissaten Morning for delta
# upstream: https://github.com/bytebeast/kissaten.nvim
# In ~/.gitconfig:
#   [include]
#     path = /path/to/this/file
#   [delta]
#     features = kissaten-morning

[delta "kissaten-morning"]
  dark = true
  light = true
  syntax-theme = none
  file-style = "#1d4fcf" bold
  file-decoration-style = "#c2c9dc" ul
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = "#c2c9dc" box
  hunk-header-line-number-style = "#9c3c00"
  line-numbers = true
  line-numbers-left-style = "#c2c9dc"
  line-numbers-right-style = "#c2c9dc"
  line-numbers-zero-style = "#686f8e"
  line-numbers-minus-style = "#b7002f"
  line-numbers-plus-style = "#24680c"
  minus-style = syntax "#efc8d7"
  minus-emph-style = syntax "#db9cb0"
  plus-style = syntax "#c5d6c8"
  plus-emph-style = syntax "#a7c0a4"
  map-styles = bold purple => syntax "#d3d8e5", bold cyan => syntax "#e2e5ee"
  blame-palette = "#eef0f6" "#e0e4ee" "#e2e5ee"
  commit-decoration-style = "#c2c9dc" box ul
  zero-style = syntax
