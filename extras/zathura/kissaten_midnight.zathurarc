# Kissaten Midnight for zathura
# upstream: https://github.com/bytebeast/kissaten.nvim

set default-bg "#16161f"
set default-fg "#c8d0f0"
set statusbar-bg "#111118"
set statusbar-fg "#a9b1d6"
set inputbar-bg "#111118"
set inputbar-fg "#c8d0f0"
set completion-bg "#1f2030"
set completion-fg "#c8d0f0"
set completion-group-bg "#1f2030"
set completion-group-fg "#7aa2f7"
set completion-highlight-bg "#363a56"
set completion-highlight-fg "#c8d0f0"
set notification-bg "#1f2030"
set notification-fg "#c8d0f0"
set notification-error-bg "#f38ba8"
set notification-error-fg "#0c0c12"
set notification-warning-bg "#e6c56f"
set notification-warning-fg "#0c0c12"
set index-bg "#16161f"
set index-fg "#c8d0f0"
set index-active-bg "#363a56"
set index-active-fg "#c8d0f0"
set scrollbar-bg "#111118"
set scrollbar-fg "#363a56"
set render-loading-bg "#16161f"
set render-loading-fg "#c8d0f0"
set recolor-lightcolor "#16161f"
set recolor-darkcolor "#c8d0f0"
set highlight-color "rgba(230,197,111,0.4)"
set highlight-active-color "rgba(249,162,106,0.5)"
set visual-caret-color "rgba(200,208,240,0.7)"
set signature-success-color "rgba(166,217,138,0.9)"
set signature-warning-color "rgba(230,197,111,0.9)"
set signature-error-color "rgba(243,139,168,0.9)"
