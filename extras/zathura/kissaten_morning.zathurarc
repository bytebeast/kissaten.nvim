# Kissaten Morning for zathura
# upstream: https://github.com/bytebeast/kissaten.nvim

set default-bg "#eef0f6"
set default-fg "#353a5c"
set statusbar-bg "#e0e4ee"
set statusbar-fg "#4f5578"
set inputbar-bg "#e0e4ee"
set inputbar-fg "#353a5c"
set completion-bg "#e0e4ee"
set completion-fg "#353a5c"
set completion-group-bg "#e0e4ee"
set completion-group-fg "#1d4fcf"
set completion-highlight-bg "#d3d8e5"
set completion-highlight-fg "#353a5c"
set notification-bg "#e2e5ee"
set notification-fg "#353a5c"
set notification-error-bg "#b7002f"
set notification-error-fg "#eef0f6"
set notification-warning-bg "#805000"
set notification-warning-fg "#eef0f6"
set index-bg "#eef0f6"
set index-fg "#353a5c"
set index-active-bg "#d3d8e5"
set index-active-fg "#353a5c"
set scrollbar-bg "#e0e4ee"
set scrollbar-fg "#c2c9dc"
set render-loading-bg "#eef0f6"
set render-loading-fg "#353a5c"
set recolor-lightcolor "#eef0f6"
set recolor-darkcolor "#353a5c"
set highlight-color "rgba(128,80,0,0.4)"
set highlight-active-color "rgba(156,60,0,0.5)"
set visual-caret-color "rgba(53,58,92,0.7)"
set signature-success-color "rgba(36,104,12,0.9)"
set signature-warning-color "rgba(128,80,0,0.9)"
set signature-error-color "rgba(183,0,47,0.9)"
