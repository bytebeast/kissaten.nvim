# Kissaten Afternoon for zathura
# upstream: https://github.com/bytebeast/kissaten.nvim

set default-bg "#282b3e"
set default-fg "#cdd5f6"
set statusbar-bg "#212435"
set statusbar-fg "#b0b9dd"
set inputbar-bg "#212435"
set inputbar-fg "#cdd5f6"
set completion-bg "#212435"
set completion-fg "#cdd5f6"
set completion-group-bg "#212435"
set completion-group-fg "#89aefe"
set completion-highlight-bg "#3c4159"
set completion-highlight-fg "#cdd5f6"
set notification-bg "#31354b"
set notification-fg "#cdd5f6"
set notification-error-bg "#f690ac"
set notification-error-fg "#1a1c2a"
set notification-warning-bg "#e8c47e"
set notification-warning-fg "#1a1c2a"
set index-bg "#282b3e"
set index-fg "#cdd5f6"
set index-active-bg "#3c4159"
set index-active-fg "#cdd5f6"
set scrollbar-bg "#212435"
set scrollbar-fg "#4a506b"
set render-loading-bg "#282b3e"
set render-loading-fg "#cdd5f6"
set recolor-lightcolor "#282b3e"
set recolor-darkcolor "#cdd5f6"
set highlight-color "rgba(232,196,126,0.4)"
set highlight-active-color "rgba(243,160,108,0.5)"
set visual-caret-color "rgba(205,213,246,0.7)"
set signature-success-color "rgba(169,216,129,0.9)"
set signature-warning-color "rgba(232,196,126,0.9)"
set signature-error-color "rgba(246,144,172,0.9)"
