# Kissaten Graveyard for zathura
# upstream: https://github.com/bytebeast/kissaten.nvim

set default-bg "#0a0a0d"
set default-fg "#bfc7e6"
set statusbar-bg "#050507"
set statusbar-fg "#a1a9cd"
set inputbar-bg "#050507"
set inputbar-fg "#bfc7e6"
set completion-bg "#171827"
set completion-fg "#bfc7e6"
set completion-group-bg "#171827"
set completion-group-fg "#739aee"
set completion-highlight-bg "#30344f"
set completion-highlight-fg "#bfc7e6"
set notification-bg "#171827"
set notification-fg "#bfc7e6"
set notification-error-bg "#ea83a0"
set notification-error-fg "#000000"
set notification-warning-bg "#ddbc66"
set notification-warning-fg "#000000"
set index-bg "#0a0a0d"
set index-fg "#bfc7e6"
set index-active-bg "#30344f"
set index-active-fg "#bfc7e6"
set scrollbar-bg "#050507"
set scrollbar-fg "#30344f"
set render-loading-bg "#0a0a0d"
set render-loading-fg "#bfc7e6"
set recolor-lightcolor "#0a0a0d"
set recolor-darkcolor "#bfc7e6"
set highlight-color "rgba(221,188,102,0.4)"
set highlight-active-color "rgba(240,154,98,0.5)"
set visual-caret-color "rgba(191,199,230,0.7)"
set signature-success-color "rgba(157,208,129,0.9)"
set signature-warning-color "rgba(221,188,102,0.9)"
set signature-error-color "rgba(234,131,160,0.9)"
