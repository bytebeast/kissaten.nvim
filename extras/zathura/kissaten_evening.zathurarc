# Kissaten Evening for zathura
# upstream: https://github.com/bytebeast/kissaten.nvim

set default-bg "#1f2133"
set default-fg "#cad3f5"
set statusbar-bg "#191a2a"
set statusbar-fg "#aeb7dc"
set inputbar-bg "#191a2a"
set inputbar-fg "#cad3f5"
set completion-bg "#191a2a"
set completion-fg "#cad3f5"
set completion-group-bg "#191a2a"
set completion-group-fg "#82aaff"
set completion-highlight-bg "#323650"
set completion-highlight-fg "#cad3f5"
set notification-bg "#272a40"
set notification-fg "#cad3f5"
set notification-error-bg "#f28fad"
set notification-error-fg "#13141f"
set notification-warning-bg "#ebcf8c"
set notification-warning-fg "#13141f"
set index-bg "#1f2133"
set index-fg "#cad3f5"
set index-active-bg "#323650"
set index-active-fg "#cad3f5"
set scrollbar-bg "#191a2a"
set scrollbar-fg "#3f4463"
set render-loading-bg "#1f2133"
set render-loading-fg "#cad3f5"
set recolor-lightcolor "#1f2133"
set recolor-darkcolor "#cad3f5"
set highlight-color "rgba(235,207,140,0.4)"
set highlight-active-color "rgba(247,164,111,0.5)"
set visual-caret-color "rgba(202,211,245,0.7)"
set signature-success-color "rgba(181,224,141,0.9)"
set signature-warning-color "rgba(235,207,140,0.9)"
set signature-error-color "rgba(242,143,173,0.9)"
